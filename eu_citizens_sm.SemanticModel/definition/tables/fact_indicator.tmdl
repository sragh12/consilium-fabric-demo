table fact_indicator
	lineageTag: 30d4cc65-0de5-4453-93cc-c93b214ba0e1
	sourceLineageTag: [dbo].[fact_indicator]

	measure 'Latest Year' = MAX ( fact_indicator[Year] )
		lineageTag: bd495888-d8f3-48c4-a969-eaea5aba0de8

	measure 'Latest Value' =
			VAR _LatestYear = [Latest Year]
			RETURN
			    CALCULATE (
			        AVERAGE ( fact_indicator[Value] ),
			        KEEPFILTERS ( fact_indicator[Year] = _LatestYear )
			    )
		lineageTag: 68f56aaf-f873-4560-bb0b-32214c265daf

	measure 'EU Average' =
			VAR _LatestYear = [Latest Year]
			RETURN
			    CALCULATE (
			        AVERAGE ( fact_indicator[Value] ),
			        REMOVEFILTERS ( dim_country[CountryCode], dim_country[CountryName_EN] ),
			        KEEPFILTERS ( fact_indicator[Year] = _LatestYear )
			    )
		lineageTag: a14766ea-b5ac-4a05-9550-519631654473

	measure 'Previous Year Value' =
			VAR _LatestYear = [Latest Year]
			RETURN
			    CALCULATE (
			        AVERAGE ( fact_indicator[Value] ),
			        REMOVEFILTERS ( fact_indicator[Year] ),
			        fact_indicator[Year] = _LatestYear - 1
			    )
		lineageTag: 0c68996a-abbb-47aa-ba38-ff8db8f58aa0

	measure 'YoY Change' = [Latest Value] - [Previous Year Value]
		lineageTag: 5c93c23d-e137-4645-8108-5a970df287c2

	measure 'YoY Change %' = DIVIDE ( [YoY Change], [Previous Year Value] )
		lineageTag: 66afb01d-0409-40fb-b53d-73d723a35870

	measure 'Variance to EU Average' = [Latest Value] - [EU Average]
		lineageTag: 93457361-9a02-4f21-a709-aaa01faffa9b

	measure 'Country Rank' =
			VAR _Direction = SELECTEDVALUE ( dim_indicator[Direction], "Higher is better" )
			RETURN
			IF (
			    _Direction = "Lower is better",
			    RANKX ( ALLSELECTED ( dim_country[CountryName_EN] ), [Latest Value],, ASC, DENSE ),
			    RANKX ( ALLSELECTED ( dim_country[CountryName_EN] ), [Latest Value],, DESC, DENSE )
			)
		lineageTag: 78cdf55b-6d70-4586-a2c7-75c41759d484

	measure 'Selected Indicator' = SELECTEDVALUE ( dim_indicator[IndicatorName_EN], "Select an indicator" )
		lineageTag: 86f4a078-7abb-4ee2-9bef-0bf959a4136f

	measure 'Dynamic Title' = [Selected Indicator] & " by country - " & FORMAT ( [Latest Year], "0" )
		lineageTag: 5ded99c6-8d23-4937-a204-227e08651d25

	measure 'Data Freshness' = "Synthetic demo data | As of " & FORMAT ( MAX ( fact_indicator[AsOfDate] ), "dd mmm yyyy" )
		lineageTag: 67ac8aa2-59fc-4aa0-9860-cde973a3368f

	column CountryCode
		dataType: string
		lineageTag: f3bfa77b-1450-4459-9cf2-b093567e262a
		sourceLineageTag: CountryCode
		summarizeBy: none
		sourceColumn: CountryCode

		annotation SummarizationSetBy = Automatic

	column Year
